# Fracture Game Server - Environment Variables
# Copy this file to .env and fill in values

# Node environment (development | production)
NODE_ENV=development

# Logging level (debug | info | warn | error)
LOG_LEVEL=info

# Venice AI SDK (NPC dialogue, narrator) — OPTIONAL, disabled by default.
# Leave VENICE_API_KEY empty to run in no-AI mode: NPCs, quests, thought
# bubbles, and the newspaper all fall back to built-in static content.
VENICE_API_KEY=
VENICE_MODEL=llama-3.3-70b
VENICE_TIMEOUT=5000

# Fish Audio TTS (NPC/narrator voice synthesis) — OPTIONAL, disabled by default.
# Read independently of Venice (its own key); in practice TTS only fires on
# Venice narration paths, so it is dormant in no-AI mode either way.
FISH_AUDIO_API_KEY=

# OpenTelemetry export — OPTIONAL, disabled by default.
# Traces/logs are only exported when an endpoint is explicitly set (i.e. you
# are running your own collector). Unset = no export, no localhost:4318 noise.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Trace sampling ratio 0.0–1.0 (production only; defaults to 1.0)
# OTEL_TRACES_SAMPLER_ARG=1.0

# Debug WebSocket server (local TUI) — enabled by default, bound to 127.0.0.1.
# Set NO_DEBUG=1 to disable; DEBUG_PORT overrides the default port (8001).
# NO_DEBUG=1
# DEBUG_PORT=8001

# CORS origins (comma-separated, e.g. https://fracture.georgelarson.me)
CORS_ORIGINS=
